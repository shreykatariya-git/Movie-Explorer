<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Movie Explorer</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #0f1117;
            color: #e8e8e8;
            line-height: 1.6;
            padding-bottom: 40px;
        }

        /*HEADER*/

        header {
            background: linear-gradient(135deg, #141722, #1d2333);
            padding: 30px 7%;
            border-bottom: 1px solid #303747;
        }

        header h1 {
            color: #ffcc00;
            font-size: 38px;
            margin-bottom: 20px;
        }

        /*NAVIGATION*/

        header ul {
            list-style: none;
            padding: 0;
        }

        header nav {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        header nav li {
            list-style: none;
        }

        header nav a {
            display: inline-block;
            padding: 10px 18px;
            background: #252c3c;
            color: #ffffff;
            text-decoration: none;
            border-radius: 8px;
            transition: 0.3s ease;
        }

        header nav a:hover {
            background: #ffcc00;
            color: #111111;
            transform: translateY(-2px);
        }

        /*HORIZONTAL LINE*/

        hr {
            border: none;
            background: #343b4c;
            margin: 25px 0;
        }

        /*HEADER TEXT*/

        header h2 {
            color: #ffffff;
            margin-bottom: 8px;
        }

        header>p {
            color: #aeb5c4;
        }

        /*FORM*/

        form {
            margin-top: 25px;
        }

        fieldset {
            border: 1px solid #3b4355;
            border-radius: 12px;
            padding: 25px;
            background: #181c27;
        }

        legend {
            padding: 0 12px;
        }

        legend h2 {
            color: #ffcc00;
        }

        label {
            color: #d7d9df;
        }

        h4 {
            margin: 12px 0 8px;
            color: #ffffff;
        }

        /*SEARCH*/

        input[type="search"] {
            width: 100%;
            max-width: 450px;
            padding: 12px 14px;
            background: #0f1117;
            color: #ffffff;
            border: 1px solid #41495c;
            border-radius: 7px;
            outline: none;
        }

        input[type="search"]:focus {
            border-color: #ffcc00;
            transform: translateY(-2px);
        }

        /*RADIO*/

        input[type="radio"] {
            accent-color: #ffcc00;
            margin-right: 5px;
            margin-left: 10px;
        }

        /*SELECT*/

        select {
            width: 100%;
            max-width: 450px;
            padding: 12px 14px;
            background: #0f1117;
            color: #ffffff;
            border: 1px solid #41495c;
            border-radius: 7px;
            outline: none;
        }

        select:focus {
            border-color: #ffcc00;
        }

        /*FORM BUTTONS*/

        input[type="submit"],input[type="reset"] {
            padding: 11px 20px;
            border: none;
            border-radius: 7px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s ease;
        }

        input[type="submit"] {
            background: #ffcc00;
            color: #111111;
        }

        input[type="submit"]:hover {
            background: #e6b800;
            transform: translateY(-2px);
        }

        input[type="reset"] {
            background: #363d4d;
            color: #ffffff;
            margin-left: 8px;
        }

        input[type="reset"]:hover {
            background: #4a5263;
            transform: translateY(-2px);
        }

        /*MAIN TITLE*/

        body>h1 {
            max-width: 1400px;
            margin: 40px auto 25px;
            padding: 0 25px;
            color: #ffffff;
            font-size: 32px;
        }

        /*MOVIE GRID*/

        #main {
            max-width: 1400px;
            margin: auto;
            padding: 0 25px;
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 25px;
        }

        /* MOVIE CARD*/

        .movies {
            width: 100%;
        }

        .movies fieldset {
            height: 100%;
            padding: 25px;
            background: #181c27;
            border: 1px solid #303849; 
            border-radius: 14px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.25);
            transition: 0.3s ease;
        }

        .movies fieldset:hover {
            transform: translateY(-6px);
            border-color: #ffcc00;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
        }

        /*MOVIE TITLE*/

        .movies legend h2,
        .movies legend h4 {
            color: #ffcc00;
            font-size: 22px;
        }

        .movies legend span {
            color: #ffffff;
        }

        /*MOVIE IMAGE*/

        .movies img {
            width: 100%;
            max-width: 100%;
            display: block;
            border-radius: 10px;
            margin: 10px 0 20px;
            transition: 0.3s ease;
        }

        .movies img:hover {
            transform: scale(1.02);
        }

        /*MOVIE INFORMATION*/

        .movies p {
            color: #bfc4cf;
            margin: 10px 0;
        }

        .movies p b {
            color: #ffffff;
        }

        /*MORE DETAILS*/

        .movies a {
            display: inline-block;
            margin-top: 12px;
            padding: 10px 18px;
            background: #ffcc00;
            color: #111111;
            text-decoration: none;
            font-weight: bold;
            border-radius: 7px;
            transition: 0.3s ease;
        }

        .movies a:hover {
            background: #ffffff;
            transform: translateX(4px);
        }

        /*BACK TO HOME*/

        body>a {
            display: block;
            width: fit-content;
            margin: 30px auto;
            padding: 12px 25px;
            background: #252c3c;
            color: #ffffff;
            text-decoration: none;
            border-radius: 8px;
            transition: 0.3s ease;
        }

        body>a:hover {
            background: #ffcc00;
            color: #111111;
        }

        /*FOOTER*/

        footer {
            text-align: center;
            color: #777f90;
            padding: 25px;
            margin-top: 30px;
            border-top: 1px solid #292f3c;
        }


        /*TABLET*/

        @media (max-width: 900px) {

            #main {
                grid-template-columns: 1fr;
            }
            header {
                padding: 25px 5%;
            }
            header h1 {
                font-size: 32px;
            }
        }

        /*MOBILE*/

        @media (max-width: 600px) {

            body {
                font-size: 14px;
            }
            header {
                padding: 20px 15px;
            }
            header h1 {
                font-size: 28px;
            }
            header nav {
                flex-direction: column;
            }
            header nav a {
                width: 100%;
                text-align: center;
            }
            #main {
                padding: 0 15px;
            }
            body>h1 {
                font-size: 25px;
                padding: 0 15px;
            }
            .movies fieldset {
                padding: 18px;
            }
            .movies img {
                width: 100%;
                max-width: 100%;
            }
            input[type="radio"] {
                margin-left: 0;
            }
            input[type="submit"],
            input[type="reset"] {
                margin-top: 8px;
            }
        }
    </style>
</head>

