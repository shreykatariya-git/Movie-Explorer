<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #0f1117;
            color: #e8e8e8;
            line-height: 1.6;
            padding-bottom: 40px;
        }

        /* HEADER */

        header {
            background: linear-gradient(135deg, #141722, #1d2333);
            padding: 30px 7%;
            border-bottom: 1px solid #303747;
        }

        header h1 {
            color: #ffcc00;
            font-size: 38px;
            margin-bottom: 20px;
        }

        header ul,
        body>ul {
            list-style: none;
        }

        header nav,
        body>ul nav {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        header nav li,
        body>ul nav li {
            list-style: none;
        }

        header nav a,
        body>ul nav a {
            display: inline-block;
            padding: 10px 18px;
            background: #252c3c;
            color: #ffffff;
            text-decoration: none;
            border-radius: 8px;
            transition: 0.3s ease;
        }

        header nav a:hover,
        body>ul nav a:hover {
            background: #ffcc00;
            color: #111111;
            transform: translateY(-2px);
        }

        hr {
            border: none;
            background: #343b4c;
            margin: 25px 0;
        }

        header h2 {
            color: #ffffff;
            margin-bottom: 8px;
            font-size: 28px;
        }

        header p {
            color: #aeb5c4;
            max-width: 800px;
            margin-bottom: 22px;
        }

        /* EXPLORE BUTTON */

        header>a {
            display: inline-block;
            padding: 12px 20px;
            background: #ffcc00;
            color: #111111;
            text-decoration: none;
            font-weight: bold;
            border-radius: 7px;
            transition: 0.3s ease;
        }

        header>a:hover {
            background: #ffffff;
            transform: translateY(-2px);
        }

        /* MOVIE GRID */

        #main {
            max-width: 1400px;
            margin: 40px auto;
            padding: 0 25px;
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 25px;
        }

        /* MOVIE CARDS */

        #main>div {
            width: 100%;
        }

        #main fieldset {
            height: 100%;
            padding: 25px;
            background: #181c27;
            border: 1px solid #303849;
            border-radius: 14px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.25);
            transition: 0.3s ease;
        }

        #main fieldset:hover {
            transform: translateY(-6px);
            border-color: #ffcc00;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
        }

        #main legend h2,
        #main legend h4 {
            color: #ffcc00;
            font-size: 22px;
        }

        #main legend span {
            color: #ffffff;
        }

        #main img {
            display: block;
            width: 100%;
            border-radius: 10px;
            margin: 10px 0 20px;
            transition: 0.3s ease;
        }

        #main img:hover {
            transform: scale(1.02);
        }

        #main p {
            color: #bfc4cf;
            margin: 10px 0;
        }

        #main p b {
            color: #ffffff;
        }

        #main a {
            display: inline-block;
            margin-top: 12px;
            padding: 10px 18px;
            background: #ffcc00;
            color: #111111;
            text-decoration: none;
            font-weight: bold;
            border-radius: 7px;
            transition: 0.3s ease;
        }

        #main a:hover {
            background: #ffffff;
            transform: translateX(4px);
        }

        /* ANALYTICS */

        body>h1 {
            max-width: 1400px;
            margin: 40px auto 25px;
            padding: 0 25px;
            color: #ffffff;
            font-size: 32px;
        }

        table {
            width: calc(100% - 50px);
            max-width: 1400px;
            margin: 0 auto 30px;
            border-collapse: collapse;
            background: #181c27;
            overflow: hidden;
            border-radius: 12px;
        }

        th,
        td {
            padding: 15px;
            text-align: left;
            border: 1px solid #343b4c;
        }

        th {
            background: #252c3c;
            color: #ffcc00;
            font-size: 17px;
        }

        td {
            color: #c3c8d2;
        }

        tr:hover td {
            background: #202635;
        }

        body>ul {
            max-width: 1400px;
            margin: 0 auto 30px;
            padding: 0 25px;
        }

        /* BACK BUTTON */

        body>a {
            display: block;
            width: fit-content;
            margin: 30px auto;
            padding: 12px 25px;
            background: #252c3c;
            color: #ffffff;
            text-decoration: none;
            border-radius: 8px;
            transition: 0.3s ease;
        }

        body>a:hover {
            background: #ffcc00;
            color: #111111;
        }

        footer {
            text-align: center;
            color: #777f90;
            padding: 25px;
            margin-top: 30px;
            border-top: 1px solid #292f3c;
        }

        /* TABLET */

        @media (max-width: 900px) {
            #main {
                grid-template-columns: 1fr;
            }

            header {
                padding: 25px 5%;
            }

            header h1 {
                font-size: 32px;
            }
        }

        /* MOBILE */

        @media (max-width: 600px) {
            body {
                font-size: 14px;
            }

            header {
                padding: 20px 15px;
            }

            header h1 {
                font-size: 28px;
            }

            header h2 {
                font-size: 23px;
            }

            header nav,
            body>ul nav {
                flex-direction: column;
            }

            header nav a,
            body>ul nav a {
                width: 100%;
                text-align: center;
            }

            #main {
                padding: 0 15px;
            }

            #main fieldset {
                padding: 18px;
            }

            body>h1 {
                font-size: 25px;
                padding: 0 15px;
            }

            table {
                width: calc(100% - 30px);
                font-size: 13px;
            }

            th,
            td {
                padding: 10px;
            }

            body>ul {
                padding: 0 15px;
            }
        }
    </style>
</head>

